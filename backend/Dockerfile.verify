# syntax=docker/dockerfile:1
# Linux race verification image, never used as a production runtime.
FROM golang:1.26.11-alpine3.24
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
RUN apk add --no-cache build-base
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ENV CGO_ENABLED=1
CMD ["go", "test", "-race", "-tags", "integration", "-p", "1", "-parallel", "1", "-json", "./...", "-count=1"]
