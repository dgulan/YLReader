# Independent offline worker. Runtime isolation flags and private IPC mount are mandatory.
FROM --platform=$BUILDPLATFORM golang:1.26.11-alpine3.24@sha256:ae52b5bc6ed045a9ed26ab03dc19327a802a9cc9aa8b27ed57f5c6b60579b0bb AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/sandboxworker

FROM scratch
COPY --from=build /out/worker /worker
USER 10001:10001
ENTRYPOINT ["/worker"]
CMD ["-socket", "/ipc/worker.sock"]
