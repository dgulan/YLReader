# Copy to .env and fill all secret values before starting Compose.
# Generate secrets independently; do not use placeholders in any deployment.

# Mandatory JWT signing secret (at least 32 random bytes in production)
JWT_SECRET=

# Base64 of 32 random bytes. Keep this key stable across restarts/upgrades.
YREADER_HEADER_KEY_primary=

# Required by docker-compose.prod.yml (no default credentials allowed)
POSTGRES_USER=yreader
POSTGRES_PASSWORD=
POSTGRES_DB=yreader
REDIS_PASSWORD=

# Initial admin account created only when the users table is empty
SEED_USERNAME=
SEED_PASSWORD=

# Host loopback HTTP port bound by frontend in docker-compose.prod.yml (behind TLS reverse proxy)
YLREADER_HTTP_PORT=8080

# Shared explicit timezone for app and isolated sandboxworkers
TZ=UTC

LOCAL_IMPORT_TIMEOUT=90s

# Optional Linux isolated workers (set automatically in docker-compose.prod.yml).
# Keep empty in local dev docker-compose.yml unless worker sockets are mounted.
YREADER_SANDBOX_SOCKETS=

# Bounded JS sandbox execution parameters (fail-closed if invalid)
# YREADER_SANDBOX_INPUT_LIMIT_MB: 1..32 (default 32)
# YREADER_SANDBOX_INFLIGHT_MB: >= 2 * InputLimit (default 64)
# YREADER_SANDBOX_MAX_CONCURRENT: 1..32 (default 4; docker-compose.prod.yml defaults to 2 workers)
YREADER_SANDBOX_INPUT_LIMIT_MB=32
YREADER_SANDBOX_INFLIGHT_MB=64
YREADER_SANDBOX_MAX_CONCURRENT=4
