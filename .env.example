# Copy to .env and fill all four values before starting Compose.
# Generate secrets independently; do not use placeholders in a deployment.
JWT_SECRET=
# Base64 of 32 random bytes. Keep this key stable across restarts/upgrades.
YREADER_HEADER_KEY_primary=
SEED_USERNAME=
SEED_PASSWORD=
LOCAL_IMPORT_TIMEOUT=90s
# Optional Linux isolated workers. Requires dedicated constrained worker containers
# and private shared IPC mounts; empty retains the current in-process mode.
YREADER_SANDBOX_SOCKETS=
